---
import '../styles/utilities.css';
import Layout from '../layouts/Layout.astro';
---
<Layout title="Pavel Novaikin" bodyClass="tw:m-0 tw:bg-[#f5f4ef] tw:text-[#213b39] tw:font-[system-ui,sans-serif]">
  <main class="tw:box-border tw:mx-auto tw:min-h-svh tw:max-w-[1000px] tw:px-7 tw:pt-[18vh] tw:pb-20">
    <h1 class="tw:my-8 tw:max-w-[750px] tw:text-[clamp(46px,8vw,88px)] tw:leading-[1.04] tw:font-medium tw:tracking-[-0.065em]">Hi there!</h1>
      <div class="tw:flex tw:flex-row tw:gap-x-2">
          <a href="/frontend/" class="tw:block tw:px-5 tw:py-2 tw:border tw:border-black">Frontend résumé <span>↗</span></a>
          <a href="/fullstack/" class="tw:block tw:px-5 tw:py-2 tw:border tw:border-black">Fullstack résumé <span>↗</span></a>
      </div>
  </main>
</Layout>
