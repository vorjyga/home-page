---
import '../../styles/global.css';
import Header from './Header.jsx';
import Summary from './Summary.jsx';
import Experience from './Experience.jsx';
import Skills from './Skills.jsx';
import Education from './Education.jsx';
import DownloadPdf from './DownloadPdf.jsx';
import { frontendResume } from '../../data/resumes.js';
const { resume = frontendResume, section = 'frontend', showDownload = false } = Astro.props;
const printWebsiteHref = `https://novaikin.com/${section}/?utm=from-cv-link`;
---
<main class="container mx-auto">
  <div class="mx-auto max-w-3xl px-4 text-left mb-20 pt-10 print:max-w-none print:px-0 print:mb-0 print:pt-0">
    {showDownload && <div class="mb-8 flex justify-end print:hidden"><DownloadPdf section={section} /></div>}
    <Header profile={resume.profile} contacts={resume.contacts} printWebsiteHref={printWebsiteHref} />
    <Summary summary={resume.summary} />
    <Experience experience={resume.experience} earlierExperience={resume.earlierExperience} />
    <Skills skills={resume.skills} />
    <Education />
  </div>
</main>
